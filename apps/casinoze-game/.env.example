# Copy to .env.local and fill in. .env.local is git-ignored.
# Set the same variables in this app's Vercel project.

# Supabase project URL. Safe to expose (ships to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key. Safe to expose (ships to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------
# WARNING - see README. The 9 player API routes under pages/api/
# currently use the service-role key, which BYPASSES every RLS
# policy. The plan is for player sites to run on the anon key
# alone. Until those routes are rewritten, this app needs the key
# below, and that is a security compromise worth closing.
# ---------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM key, the SAME value as the admin app's ENCRYPTION_KEY.
# Needed so /api/player/game-accounts can decrypt a player's own game
# password for display. Exactly 64 hex characters. Server-side only.
ENCRYPTION_KEY=

# ===============================================================
# PER-CASINO CONFIG — this is what makes one deploy a new casino.
# The three keys ABOVE (Supabase URL/anon, service-role, encryption)
# are SHARED across every casino on this platform; copy them as-is.
# Everything BELOW is unique to THIS casino's deployment.
# ===============================================================

# This casino's tenant UUID. Create the tenant in the admin app
# (Superadmin -> Create Tenant); it seeds levels/games/payment
# methods/referral tiers/settings and gives you this id. No fallback:
# if blank, signups don't get stamped with a tenant.
NEXT_PUBLIC_TENANT_ID=

# --- Branding (all optional; blank = the Casinoze Room defaults) ---
# Full name: page titles, headings — "Lucky Reef"
NEXT_PUBLIC_BRAND_NAME=
# Short name used in casual copy — "Lucky Reef"
NEXT_PUBLIC_BRAND_SHORT=
# Small eyebrow tagline on the auth screens
NEXT_PUBLIC_BRAND_TAGLINE=
# Two-line logo wordmark text next to the mark
NEXT_PUBLIC_BRAND_MARK_TOP=
NEXT_PUBLIC_BRAND_MARK_BOTTOM=
# Support address shown in copy; blank hides it
NEXT_PUBLIC_SUPPORT_EMAIL=
# Logo mark image path under /public. Default /images/logo/logo.png —
# either replace that file in this app, or point here at another asset.
NEXT_PUBLIC_BRAND_LOGO=
