# Copy to .env.local and fill in. .env.local is git-ignored.
# Set the same variables in this app's Vercel project.

# Supabase project URL. Safe to expose (ships to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key. Safe to expose (ships to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------
# WARNING - see README. The 9 player API routes under pages/api/
# currently use the service-role key, which BYPASSES every RLS
# policy. The plan is for player sites to run on the anon key
# alone. Until those routes are rewritten, this app needs the key
# below, and that is a security compromise worth closing.
# ---------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM key, the SAME value as the admin app's ENCRYPTION_KEY.
# Needed so /api/player/game-accounts can decrypt a player's own game
# password for display. Exactly 64 hex characters. Server-side only.
ENCRYPTION_KEY=
